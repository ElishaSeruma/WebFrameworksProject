extends layout
include _includes/mixins

block content
  .row.g-4.auth-page
    .col-12.col-md-6
      +authHero(heroImage)
    .col-12.col-md-6.d-flex.align-items-center
      .card.auth-card.rounded-4.w-100
        .card-body.p-4.p-lg-5
          small.text-body-secondary= pageHeader.kicker
          h1.h4.mt-1.mb-4= pageHeader.title
          form(action=form.action, method=form.method)
            each field in form.fields
              +formField(field)
            .mb-4
              small.text-body-secondary.d-block.mb-1= usernamePreview.label
              span.badge.rounded-pill.username-pill= usernamePreview.value
            button.btn.btn-united.w-100(type='submit')= form.submitLabel
