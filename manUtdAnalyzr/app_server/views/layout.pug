doctype html
html(lang='en', data-bs-theme='dark')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title= title
    link(rel='icon', type='image/svg+xml', href='/images/logo.svg')
    link(rel='stylesheet', href='/stylesheets/bootstrap.min.css')
    link(rel='stylesheet', href='/stylesheets/font-awesome.min.css')
    link(rel='stylesheet', href='/stylesheets/style.css')
  body
    //- Navbar (based on a Bootsnipp snippet by maridlcrmn)
    nav.navbar.navbar-expand-md.navbar-inverse
      .container
        a.navbar-brand.d-flex.align-items-center.gap-2(href='/')
          img.brand-logo(src='/images/logo.svg', alt='Manchester United crest', width='36', height='36')
          span Stats Analyzr
        button.navbar-toggler.collapsed(type='button', data-bs-toggle='collapse', data-bs-target='#navbarMain', aria-controls='navbarMain', aria-expanded='false', aria-label='Toggle navigation')
          span.navbar-toggler-icon

        #navbarMain.collapse.navbar-collapse
          ul.navbar-nav.navbar-right.ms-auto
            li.nav-item
              a.nav-link(href='/') Home
            li.nav-item
              a.nav-link(href='/register') Register
            li.nav-item
              a.nav-link(href='/login') Login
            li.nav-item
              a.nav-link(href='/stats') View Stats

    main.container.py-4
      block content

    script(src='/javascripts/bootstrap.bundle.min.js')
